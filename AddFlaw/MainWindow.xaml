<Window x:Class="AddFlaw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:HelixToolkit="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        xmlns:local="clr-namespace:AddFlaw"
        mc:Ignorable="d"
        Title="AddFlaw - 3D Flaw Adding Tool" Height="1024" Width="1200"
        Background="#F0F0F0" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="loadModelButton" Click="LoadModelButton_Click" 
                        Content="📁 Open Model" Foreground="White" Background="#0078D4" 
                        Padding="12,8" FontSize="12" FontWeight="Bold" Cursor="Hand"
                        BorderThickness="0"  Margin="0,0,10,0" />
                <Button x:Name="loadFlawsButton" Click="LoadFlawsButton_Click" 
                        Content="Load Flaws" Foreground="White" Background="#0078D4" 
                        Padding="12,8" FontSize="12" FontWeight="Bold" Cursor="Hand"
                        BorderThickness="0"  Margin="0,0,10,0" />
                <Button x:Name="SaveFlawsButton" Click="SaveFlawsButton_Click" 
                        Content="Save Flaws" Foreground="White" Background="#0078D4" 
                        Padding="12,8" FontSize="12" FontWeight="Bold" Cursor="Hand"
                        BorderThickness="0"  Margin="0,0,10,0" />

                <Button x:Name="addFlawButton" Click="AddFlawButton_Click" 
                        Content="➕ Add Flaw" Foreground="White" Background="#28A745" 
                        Padding="12,8" FontSize="12" FontWeight="Bold" Cursor="Hand"
                        BorderThickness="0"  Margin="0,0,10,0" />

                <Separator Background="#404040" Width="1" Margin="5,0" />

                <TextBlock Text="File:" Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0" />
                <TextBlock x:Name="filePathLabel" Text="No file loaded" Foreground="#B0B0B0" 
                           VerticalAlignment="Center" Margin="0,0,20,0" />

                <Separator Background="#404040" Width="1" Margin="5,0" />

                <TextBlock Text="Model Color:" Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0" />
                <ComboBox x:Name="modelColorCombo" Width="80" Margin="0,0,15,0" VerticalAlignment="Center"
                          SelectionChanged="ModelColorCombo_SelectionChanged">
                    <ComboBoxItem Content="Blue" IsSelected="True" />
                    <ComboBoxItem Content="Grey" />
                </ComboBox>



                <TextBlock Text="Flaw Color:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="flawColorCombo" Width="80" Margin="0,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="FlawColorCombo_SelectionChanged">
                    <ComboBoxItem Content="Red" IsSelected="True" />
                    <ComboBoxItem Content="Green" />
                </ComboBox>
                <!-- NEW: Emission Alpha controls -->
                <Separator Background="#404040" Width="1" Margin="5,0" />

                <TextBlock Text="Glow Alpha:" Foreground="White"
                           VerticalAlignment="Center" Margin="10,0,5,0" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider x:Name="EmissionAlphaSlider" Minimum="0" Maximum="128" Value="20" Width="140" TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,0,5,0" ToolTip="Adjust emissive glow strength (0 = off, 128 = max)" ValueChanged="EmissionAlphaSlider_ValueChanged" />
                    <Border Background="#404040" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                        <TextBlock x:Name="EmissionAlphaLabel" Text="60" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <Separator Background="#404040" Width="1" Margin="5,0" />
                <CheckBox x:Name="showAxisCheckBox" Content="Show Axis" Foreground="White" IsChecked="True" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Checked="ShowAxisCheckBox_Checked" Unchecked="ShowAxisCheckBox_Unchecked" />
            </StackPanel>
        </Border>

        <!-- Info Bar -->
        <Border Grid.Row="1" Background="#E8E8E8" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Flaws placed:" Foreground="#333333" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="flawsCountLabel" Text="0" Foreground="#0078D4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0" />
                <TextBlock Text="Selected flaw:" Foreground="#333333" FontSize="11" VerticalAlignment="Center" Margin="23,0,0,0" />
                <TextBlock x:Name="selectedFlawIdLabel" Text="None" Foreground="#0078D4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,20,0" />
                <TextBlock Text="Label:" Foreground="#333333" FontSize="11" VerticalAlignment="Center" />
                <TextBox x:Name="flawLabelTextBox" Width="300" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" LostFocus="FlawLabelTextBox_LostFocus" />
                <Button x:Name="applyFlawLabelButton" Content="Apply" FontSize="11" Padding="8,2" Margin="0,0,0,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="False" 
                        Click="ApplyFlawLabelButton_Click" LostFocus="ApplyFlawLabelButton_LostFocus" />
            </StackPanel>
        </Border>

        <!-- 3D Viewport -->
        <Grid Grid.Row="2">
            <HelixToolkit:HelixViewport3D x:Name="viewport3D"  ShowCoordinateSystem="True"  ShowCameraInfo="True" ZoomExtentsWhenLoaded="True" ZoomAroundMouseDownPoint="True" 
                                          IsChangeFieldOfViewEnabled="True" IsMoveEnabled="True" IsRotationEnabled="True" >
                <HelixToolkit:DefaultLights />
                <ModelVisual3D x:Name="modelRoot" />
            </HelixToolkit:HelixViewport3D>
            <!-- Flaws List Overlay (left, like measurement/annotation list in CAD/3D Slicer) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,50,15,15" Background="#CCF5F5F5" CornerRadius="4" Padding="8" Width="230">
                <DockPanel>
                    <TextBlock Text="Flaws" DockPanel.Dock="Top" FontWeight="Bold" FontSize="12" Foreground="#333333" Margin="0,0,0,4" />
                    <ListBox x:Name="flawListBox" FontSize="12" Background="#00000000" BorderThickness="0" SelectionChanged="FlawListBox_SelectionChanged" MouseDoubleClick="FlawListBox_MouseDoubleClick" HorizontalContentAlignment="Stretch" LostFocus="FlawListBox_LostFocus" >
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">                                                  <!-- Item Style -->
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="#F3F3F3" CornerRadius="4" Padding="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">                 <!-- Hover -->
                                                    <Setter TargetName="border" Property="Background" Value="#E2E2E2"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">                   <!-- Selected -->
                                                    <Setter TargetName="border" Property="Background" Value="#D0E7FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </ListBox.Resources>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>    <!-- ID -->
                                        <ColumnDefinition Width="10"/>      <!-- Spacing -->
                                        <ColumnDefinition Width="*"/>       <!-- Label -->
                                        <ColumnDefinition Width="Auto"/>    <!-- Color Icon -->
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#0078D4" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding Id}" Foreground="White" FontSize="11" FontWeight="Bold"/>   <!-- ID Badge -->
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="3" Width="18" Height="18" Margin="10,0,0,0" Padding="0" BorderThickness="0" Background="{Binding ColorBrush}" Tag="{Binding}" PreviewMouseLeftButtonDown="FlawColorButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="FlawColorButton_PreviewMouseLeftButtonUp" LostMouseCapture="FlawColorButton_LostMouseCapture">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="9" Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>
            <!-- View Navigation Pad (top-right, similar to nav widgets in Fusion/Blender/SketchUp) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Background="#66000000" CornerRadius="6" Padding="6">
                <StackPanel>
                    <Label Content="Arrows for Position" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" Padding="0" />
                    <Label Content="Shift for Target" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" Padding="0" />
                    <Label Content="Control for Pos" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" Padding="0" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Width="28" Height="28" Content="O" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Wide Field of View" Click="ExpandFieldOfView_Click" />
                        <Button Grid.Row="0" Grid.Column="1" Width="28" Height="28" Content="▲" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Y Axis -" Click="WalkUpButton_Click" />
                        <Button Grid.Row="0" Grid.Column="2" Width="28" Height="28" Content="+" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Z Axis +" Click="WalkInButton_Click" />
                        <Button Grid.Row="1" Grid.Column="0" Width="28" Height="28" Content="◀" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="X Axis +" Click="WalkLeftButton_Click" />
                        <Button Grid.Row="1" Grid.Column="1" Width="28" Height="28" Content="●" FontSize="10" Margin="2" Background="#555555" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Zoom extents" Click="WalkCenterButton_Click" />
                        <Button Grid.Row="1" Grid.Column="2" Width="28" Height="28" Content="▶" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="X Axis +" Click="WalkRightButton_Click" />
                        <Button Grid.Row="2" Grid.Column="0" Width="28" Height="28" Content="-" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Z Axis -" Click="WalkOutButton_Click" />
                        <Button Grid.Row="2" Grid.Column="1" Width="28" Height="28" Content="▼" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Y Axis +" Click="WalkDownButton_Click" />
                        <Button Grid.Row="2" Grid.Column="2" Width="28" Height="28" Content="o" FontSize="12" Margin="2" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Narrow Field of View" Click="NarrowFieldOfView_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15,180,15,90" Background="#66000000" CornerRadius="4" Padding="6">
                <StackPanel>
                    <Label Content="Key Legend" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,4" Padding="0" HorizontalAlignment="Center" />
                    <Label Content="Position (Ctrl + Key):" FontSize="10"  Foreground="#F0F0F0" Margin="0" Padding="0" />
                    <Label Content="  X: Left / Right" FontSize="10"  Foreground="#DDDDDD" Margin="0" Padding="0" />
                    <Label Content="  Y: Up / Down" FontSize="10"  Foreground="#DDDDDD" Margin="0" Padding="0" />
                    <Label Content="  Z: Plus (+) / Minus (-)" FontSize="10" Foreground="#DDDDDD" Margin="0,0,0,4" Padding="0" />
                    <Label Content="Target (Shift + Key):" FontSize="10" Foreground="#F0F0F0" Margin="0" Padding="0" />
                    <Label Content="  X: Left / Right" FontSize="10" Foreground="#DDDDDD" Margin="0" Padding="0" />
                    <Label Content="  Y: Up / Down"  FontSize="10"  Foreground="#DDDDDD" Margin="0" Padding="0" />
                    <Label Content="  Z: Plus (+) / Minus (-)"  FontSize="10" Foreground="#DDDDDD" Margin="0,0,0,4" Padding="0" />
                    <Label Content="Field of View:" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  O  /  o"  FontSize="10"  Foreground="#DDDDDD" Padding="0" />
                    <Label Content="Keys:" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Arrow Keys = Move Target" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  W + S = Back and Forth " FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  A + D = Left and Right" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Q + Z = Up and Down" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Home = Reset" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + F = Front View" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + B = Back View" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + L = Left View" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + R = Right View" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + U = Up" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Ctrl + D = Down" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="Mouse:" FontSize="10" Foreground="#F0F0F0" Padding="0" />
                    <Label Content="  Wheel = Zoom" FontSize="10" Foreground="#DDDDDD" Padding="0" />
                    <Label Content="  Sh + R. Btn + Drag = Pan" FontSize="10" Foreground="#DDDDDD" Padding="0" />
                    <Label Content="  R. Btn + Drag = Orbit" FontSize="10" Foreground="#DDDDDD" Padding="0" />
                    <StackPanel Orientation="Horizontal">
                        <Label Content=" X " Foreground="Cyan" />
                        <Label Content=" Y " Foreground="Magenta" />
                        <Label Content=" Z " Foreground="DarkGoldenrod" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <StatusBar Grid.Row="3" Background="#E8E8E8" Padding="10">
            <TextBlock x:Name="statusLabel" Text="Ready" Foreground="#333333" FontSize="11" />
        </StatusBar>
    </Grid>
</Window>
